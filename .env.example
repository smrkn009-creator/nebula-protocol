# ---- Server ----
PORT=3000
NODE_ENV=development
# Long random string used to sign session cookies. MUST change in production.
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

# ---- Database ----
# LOCAL: leave empty → uses built-in SQLite file (data/quiz.db), zero setup.
# PRODUCTION (free hosting): paste your Neon Postgres connection string here.
# Example: postgresql://user:pass@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Discord OAuth (player login) ----
# Create an app at https://discord.com/developers/applications
# Redirect URI must be: https://YOUR-DOMAIN/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public base URL of this site, e.g. https://nebula-protocol.onrender.com
BASE_URL=http://localhost:3000

# ---- Admin bootstrap ----
ADMIN_USERNAME=admin
# Set this on hosting so the password NEVER appears in (possibly visible) logs.
# If empty, the server generates one and prints it in the console (local dev only).
# ADMIN_BOOTSTRAP_PASSWORD=

# ---- Security tuning ----
# Comma-separated IPs allowed to reach /admin (optional, empty = allow all + login+2FA)
ADMIN_IP_ALLOWLIST=
